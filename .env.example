# Copy to .env and fill in. No value here is a real credential.
#
#   cp .env.example .env
#
# Every variable this application reads is listed below. Values shown are the
# defaults that apply when the variable is absent, except where marked REQUIRED.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# The provider is passed straight to langchain's init_chat_model(), so any
# provider it supports works here. Local (ollama) is the default: the system is
# designed to run entirely on your own hardware with no data leaving it.
# Using ollama also requires Ollama running locally with the model pulled:
#   ollama pull gemma3:4b-it-qat
RAG_AGENT_MODEL_PROVIDER=ollama
RAG_AGENT_MODEL_NAME=gemma3:4b-it-qat
RAG_AGENT_MODEL_TEMPERATURE=0

RAG_AGENT_APP_NAME=rag-enterprise-agent
RAG_AGENT_DEBUG=false

# Grounded synthesis is opt-in. With it off (the default) the answer layer is
# purely extractive and does no generation of its own.
RAG_AGENT_ENABLE_SYNTHESIS=false

# ---------------------------------------------------------------------------
# MCP server — the integration layer
# ---------------------------------------------------------------------------
# REQUIRED. Absolute path to your local clone of the RAG_ENTERPRISE_MCP_SERVER
# repository. There is no default: the MCP server is a separate repository
# because the agent layer has no direct data access, so its location cannot be
# guessed. The app refuses to start without it.
RAG_AGENT_MCP_SERVER_REPO=

# Interpreter used to launch the MCP server as a child process. Leave blank to
# use the interpreter running this app, which is correct when the MCP server is
# installed into the same environment.
RAG_AGENT_MCP_SERVER_PYTHON=

RAG_AGENT_MCP_SERVER_NAME=rag-enterprise-mcp
RAG_AGENT_MCP_SERVER_MODULE=rag_enterprise_mcp.server
RAG_AGENT_MCP_SERVER_VERSION=0.1.0
RAG_AGENT_MCP_SERVER_ENCODING=utf-8
# Comma-separated extra environment variable names to pass to the MCP child.
RAG_AGENT_MCP_ENV_PASSTHROUGH=

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
RAG_AGENT_API_HOST=127.0.0.1
RAG_AGENT_API_PORT=8080

# ---------------------------------------------------------------------------
# Run artefacts — paths are relative to the working directory
# ---------------------------------------------------------------------------
RAG_AGENT_AUDIT_LOG_PATH=runs/audit-log.jsonl
RAG_AGENT_APPROVALS_PATH=runs/approvals.jsonl
RAG_AGENT_EVAL_RUNS_DIR=runs/eval-runs
RAG_AGENT_RUN_RESULTS_DIR=runs/run-results
RAG_AGENT_RED_TEAM_FINDINGS_PATH=config/red-team-findings.json
RAG_AGENT_RED_TEAM_LATEST_PATH=runs/red-team/latest.json

# ---------------------------------------------------------------------------
# Cost estimation — display only, no billing effect
# ---------------------------------------------------------------------------
RAG_AGENT_INPUT_TOKEN_COST_PER_1M=3.0
RAG_AGENT_OUTPUT_TOKEN_COST_PER_1M=15.0
RAG_AGENT_DEFAULT_ESTIMATED_TOKENS_PER_QUERY=2500

# ---------------------------------------------------------------------------
# Backend — passed through to the MCP server, which calls the backend over HTTP
# ---------------------------------------------------------------------------
# These are read without the RAG_AGENT_ prefix.
RAG_BACKEND_BASE_URL=http://127.0.0.1:8000
RAG_BACKEND_TIMEOUT_SECONDS=30
RAG_BACKEND_BEARER_TOKEN=
# Only used when the backend runs with AUTH_MODE=dev. Must match the values you
# set in the backend's own .env — see the starter repository's .env.example.
RAG_BACKEND_DEV_LOGIN_EMAIL=
RAG_BACKEND_DEV_LOGIN_PASSWORD=

# ---------------------------------------------------------------------------
# Provider credentials — only needed for hosted providers, not for ollama
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
